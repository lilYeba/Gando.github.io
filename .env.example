# ==============================================================================
# PRICE TRACKER SK — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# 1. Database Configuration
# Local SQLite database file path (used by default via Node 24 native node:sqlite)
SQLITE_DB_PATH="./data/pricetracker.sqlite"

# Optional PostgreSQL connection string for cloud/production deployments
# (See prisma/schema.prisma and db/migrations/001_initial_schema.postgres.sql)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pricetracker_sk?schema=public"

# 2. Application Public URL & Locale
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="sk-SK"
NEXT_PUBLIC_DEFAULT_CURRENCY="EUR"

# 3. Retailer Ingestion Settings
# Rate-limit delay between live HTTP requests to retailer pages (in milliseconds)
INGESTION_RATE_LIMIT_MS="600"
# Enable live network fetching during manual ingestion jobs ("true" or "false")
ENABLE_LIVE_RETAILER_FETCH="true"

# 4. Security & Admin Operations
# Secret token for triggering protected administrative ingestion or review endpoints
ADMIN_API_SECRET="change-me-in-production-min-32-chars-secret"
# Secret salt for signing non-guessable shopping list share tokens
SHARE_TOKEN_SECRET="change-me-share-token-secret-key-2026"

# 5. Optional Email Delivery Service (for Price Alerts)
# Note: When SMTP_HOST or RESEND_API_KEY is not configured, Price Tracker SK
# transparently disables email delivery and uses verified in-app notifications only.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="upozornenia@pricetracker.sk"
